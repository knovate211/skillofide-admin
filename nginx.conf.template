server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    # SPA: everything that isn't a real file falls back to index.html so
    # client-side routes (/users, /tests/:id, …) resolve. index.html must be
    # revalidated every load: it names the current hashed bundles, and a
    # cached copy after a deploy points at files that no longer exist.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # Vite puts a content hash in every file name under /assets, so a changed
    # file always gets a new URL and these can be cached for good.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Proxy all API traffic to the gateway. API_UPSTREAM is injected at container
    # start (docker envsubst); defaults to the api-gateway service on the network.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
